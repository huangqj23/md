# 复制为 .env 后填写；.env 不会提交。没填 key 的厂商会在测试里自动跳过。

# 302.AI 中转：一个 key 调 Seedance、可灵、MiniMax H3、Seedream、GPT Image、配音和大模型。
# 只用中转的话，下面各家直连的 key 都可以不填。
RELAY_API_KEY=
# 默认 https://api.302.ai；国内网络可以换成 https://api.302ai.com
RELAY_BASE_URL=
# off：不走系统代理。本机开着 Clash 等代理、又连国内节点 api.302ai.com 时建议设为 off
AI_VIDEO_PROXY=

# 火山方舟：Seedance 视频、Seedream 图片、豆包大模型共用一个 key
ARK_API_KEY=

# 可灵开放平台：AccessKey / SecretKey
KLING_ACCESS_KEY=
KLING_SECRET_KEY=

# MiniMax 开放平台：H3 视频和语音合成共用
MINIMAX_API_KEY=

# 豆包语音（语音合成 2.0）：控制台里的 APP ID 和 Access Token
DOUBAO_TTS_APP_ID=
DOUBAO_TTS_ACCESS_KEY=

# 可选：GPT Image 2（需要海外通道，OPENAI_BASE_URL 可以填中转地址）
OPENAI_API_KEY=
OPENAI_BASE_URL=

# 可选：LLM 盲评（豆包大模型用上面的 ARK_API_KEY）
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
MOONSHOT_API_KEY=

# 单次运行的预算上限（元），预计花费超过它就不跑
BENCH_BUDGET_CNY=300
