# 复制为 .env 后填写；.env 不会提交。没填 key 的模型会显示「未就绪」并自动跳过。

# 火山方舟 Agent Plan 专属 API Key（在 Agent Plan 控制台获取；普通方舟 key、Coding Plan key 都不能用）。
# 只用于 Seedance 视频和 Seedream 图片：套餐条款不允许用 API 调用文本模型。
ARK_PLAN_API_KEY=

# MiniMax M Plan 订阅 Key（套餐详情页，sk-cp- 开头）：H3 视频和语音合成共用。
# 按量计费的 sk-api- key 也能用，但会扣账户余额。
MINIMAX_API_KEY=

# Gemini API Key（Google AI Studio，点「复制密钥」后粘贴，别手打）：配音 Gemini 3.8 Flash TTS、可选图片 Nano Banana 2.1。
# 结算按 Google Cloud 项目算：项目开通结算后（Nano Banana 必须），这个 Key 的配音也按量计费。
GEMINI_API_KEY=
# 访问 Google 用的代理（国内必填），只给 Gemini 用，例如 http://127.0.0.1:7890
GEMINI_PROXY=

# off：国内接口（方舟、MiniMax）不走系统代理，直连更稳
AI_VIDEO_PROXY=off

# 可选，默认关闭（providers.yaml 里 enabled: false）：可灵、豆包语音、GPT Image 2 的按量 key
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
DOUBAO_TTS_APP_ID=
DOUBAO_TTS_ACCESS_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=

# 单次运行的预算上限（元），预计花费超过它就不跑
BENCH_BUDGET_CNY=300
