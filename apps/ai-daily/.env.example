# 复制成 .env 后填写。.env 不进版本库。

# Obsidian vault 根目录（草稿写到 <vault>/AI_Daily/YYYY-MM/）
AI_DAILY_VAULT=D:\Obisidian
# 运行 _brand/hollis23 下 cover.py / watermark.py 用的 Python（需要 Pillow + matplotlib）
AI_DAILY_BRAND_PYTHON=E:\python3\python.exe

# ---- 模型（推荐在 md 扩展的“AI 早报 → 模型设置”里配置）
# 面板保存后写入 data/llm.json（key 用 Windows DPAPI 加密），并且优先于下面这几行。
# 下面的 LLM_* 只在没有 data/llm.json 时生效：一个 OpenAI 兼容接口同时用于选题和写稿。
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
# 选题（一次调用，输入长）用便宜的模型，写作用好一点的模型
LLM_MODEL_TRIAGE=deepseek-flash
LLM_MODEL_WRITE=deepseek-v4-pro
# 可选：透传给接口的额外参数（JSON），例如开启思考：{"thinking": {"type": "enabled"}}
LLM_EXTRA_BODY=

# ---- 可选：GitHub token（不需要任何权限），用来查热榜项目的创建时间。不设时每小时只能查 60 次，
# 一天跑一次够用；一小时内反复重新生成可能被限流（限流后剩下的项目不查，条目保留）
# GITHUB_TOKEN=
