{% macro badge(ev) %}
{{ badge_line(ev) }}
{% endmacro %}
{% macro figure(ev) %}
{% if ev.image_path %}
![{{ ev.display_title }}]({{ ev.image_path }})

{% endif %}
{% endmacro %}
{# 图源接在图片下面第一段的末尾，放在括号里，不单独一行（用户 2026-10-04 要求） #}
{% macro body(ev) %}
{% for p in ev.paragraphs %}
{{ p }}{% if loop.first and ev.image_path and ev.image_credit %}（{{ ev.image_credit }}）{% endif %}

{% endfor %}
{% if ev.image_path and ev.image_credit and not ev.paragraphs %}
（{{ ev.image_credit }}）

{% endif %}
{% endmacro %}
{% macro details(ev, with_note=True) %}
{% if ev.quotes %}
> 原文：{{ ev.quotes[0].source_quote }}

{% endif %}
{% if ev.vram or (with_note and ev.engineer_note) %}
{% if ev.vram %}
- **显存估算**：{{ ev.vram }}
{% endif %}
{% if with_note and ev.engineer_note %}
- **工程师视角**：{{ ev.engineer_note }}
{% endif %}

{% endif %}
{% if ev.flags %}
【待核对：{{ ev.flags | join("；") }}】

{% endif %}
{% endmacro %}
